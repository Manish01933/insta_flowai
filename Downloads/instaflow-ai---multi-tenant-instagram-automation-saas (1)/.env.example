# =============================================================================
# InstaFlow AI — environment template
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real keys. The values below are placeholders only.
#
# Per-variable reference: docs/ENVIRONMENT.md
# =============================================================================

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Primary provider. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY"

# Primary model (OpenRouter model id). Default in code:
#   inclusionai/ling-3.0-flash
# "free", "auto" and "default" are aliases for that default. Keep it current —
# models get retired, and a retired id fails every DM until the code remaps it.
#
# The default is deliberately NOT a ':free' id. Measured 2026-10-09 with the
# production key, three identical Hinglish calls each: google/gemma-4-31b-it:free
# answered 1/3 (HTTP 429, shared-pool rate limit), nvidia/nemotron-3-super-120b-a12b:free
# 2/3, the ling-3.0-flash family 3/3 (median 2.1s). A rate-limited default is
# indistinguishable from a dead bot — the call fails, Gemini is tried next and
# the customer gets the canned sentence. Cost of that reliability is about
# $0.021 per 1M prompt tokens (~₹0.002 per DM reply).
# Set this to a ':free' id to trade that reliability back for zero cost.
# Other options: google/gemma-4-31b-it:free, nvidia/nemotron-3-super-120b-a12b:free,
# google/gemini-2.5-flash, deepseek/deepseek-chat
# Retired ids (ling-3.0-flash-sante, ling-3.0-flash-fin, and any ling-3.0-flash
# ':free' variant) are remapped to the default with a warning — the whole
# 'sante'/'fin' family vanished from OpenRouter's catalogue on 2026-10-14.
OPENROUTER_MODEL="inclusionai/ling-3.0-flash"

# Fallback provider (used automatically when OpenRouter fails). Get a key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Fallback model. `gemini-flash-latest` tracks the current free-tier flash model.
GEMINI_MODEL="gemini-flash-latest"

# ---------------------------------------------------------------------------
# OmniRoute backup (third in the chain: OpenRouter -> Gemini -> OmniRoute).
# Any OpenAI-compatible gateway works. For a self-hosted OmniRoute instance the
# default below (http://localhost:20128/v1) works from a laptop running the dev
# server; a HOSTED deploy (Railway) cannot reach localhost — set OMNIROUTE_BASE_URL
# to a public endpoint there (same /v1 style root; the server appends
# /chat/completions and /models).
# A model id is REQUIRED — OmniRoute's own catalogue differs from OpenRouter's,
# so OPENROUTER_MODEL is NOT reused. Key + model together enable the backup.
# ---------------------------------------------------------------------------
OMNIROUTE_API_KEY="sk-YOUR_OMNIROUTE_KEY"
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OMNIROUTE_MODEL="your-model-slug"

# ---------------------------------------------------------------------------
# Meta / Instagram — Facebook Login flavour (classic)
# ---------------------------------------------------------------------------
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"

# ---------------------------------------------------------------------------
# Meta / Instagram — Instagram Login flavour ("Instagram API with Instagram
# Login"). Set BOTH to use it; when set it takes precedence over Facebook Login
# and every call goes to graph.instagram.com with IGAA… tokens.
# ---------------------------------------------------------------------------
IG_APP_ID="YOUR_INSTAGRAM_APP_ID"
IG_APP_SECRET="YOUR_INSTAGRAM_APP_SECRET"

# Graph version for graph.instagram.com calls (code default: v23.0).
# (The Facebook Graph version is fixed at v21.0 in server/metaApi.ts.)
IG_GRAPH_API_VERSION="v23.0"

# Explicit OAuth redirect URI. Leave empty to derive it from APP_URL
# (APP_URL + /api/instagram/oauth/callback). Must be whitelisted in the Meta app.
META_REDIRECT_URI=""

# Must match the Verify Token set in Meta App Dashboard > Webhooks > Instagram.
META_VERIFY_TOKEN="YOUR_META_VERIFY_TOKEN"

# How incoming webhook deliveries are authenticated.
#   enforce (default) = a delivery signed with an unknown secret is dropped (401)
#   warn              = log the failure but process the delivery anyway
# `warn` lets anyone who knows the webhook URL inject a delivery — temporary only.
WEBHOOK_SIGNATURE_MODE="enforce"

# ---------------------------------------------------------------------------
# Encryption (at-rest protection for stored Instagram tokens)
# ---------------------------------------------------------------------------
# AES-256-GCM master key. Use at least 32 random characters. If unset, the code
# falls back to a built-in default key and warns — never do that in production:
# every deployment without a unique key shares the same encryption key.
ENCRYPTION_MASTER_KEY="YOUR_LONG_RANDOM_ENCRYPTION_KEY_32_CHARS_MIN"

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------
# The exact origin customers open (scheme + host). Used for the OAuth redirect
# URI, data-deletion callback and the links on the public legal pages.
APP_URL="https://your-domain.com"

# Persistent storage for every JSON store (connections, inbox, leads, plans…).
# Leave empty in local dev (defaults to ./.data). On Railway/Render/Cloud Run you
# MUST set this to a mounted volume path or all data is lost on every deploy.
DATA_DIR=""

# Set to "production" on the host: switches serving from Vite dev middleware to
# the built ./dist bundle and enables production warnings.
NODE_ENV="development"

# Hosts usually inject PORT; the server falls back to 3000.
PORT=3000

# Webhook de-duplication window (ms). Default 1800000 (30 min).
WEBHOOK_DEDUPE_TTL_MS=1800000

# ---------------------------------------------------------------------------
# Bot defence (server/botGuard.ts) — stops two connected accounts talking
# ---------------------------------------------------------------------------
# Two Instagram accounts that are both connected here must never answer each
# other: their bots would reply to one another forever (it happened). The first
# two flags configure the identity check, the last two are the universal failsafe
# that stops ANY loop, including one with an external auto-responder.
#
# Refuse to auto-reply when the sender is another InstaFlow-connected account.
# Default true. Set "false" only to debug the guard itself.
IG_ISOLATE_CONNECTED_ACCOUNTS="true"

# Resolve the sender's @username from their Instagram-scoped ID
# (GET graph.instagram.com/<IGSID>?fields=username) so identity matching works
# even when Meta sends a scoped id instead of the account id. One lookup per new
# sender, cached on disk. Default true; needs instagram_business_basic +
# instagram_business_manage_messages (and Meta's Advanced Access to resolve
# users you do not own). A failure is not fatal — the burst cap below still runs.
IG_RESOLVE_SENDER_USERNAMES="true"

# Failsafe: an error is logged and replies to that one conversation stop once it
# has received this many bot replies inside the window. A real customer never
# reaches it; a bot-to-bot loop trips it within seconds.
IG_REPLY_BURST_MAX=8
IG_REPLY_BURST_WINDOW_MS=300000

# Inbox chat retention (days). Default 30.
CHAT_RETENTION_DAYS=30

# Extra Vite dev-server allowed hosts (comma separated) for tunnels. Dev only.
ALLOWED_HOSTS=""

# ---------------------------------------------------------------------------
# Selling the service (self-serve plans + Razorpay) — OPTIONAL, default OFF
# ---------------------------------------------------------------------------
# Leave ALL of these empty to keep billing OFF: every tenant keeps working and
# the dashboard only offers the free trial. Once KEY_ID and KEY_SECRET exist,
# tenants without a live plan stop getting AI replies (messages still land in
# the inbox). For Indian customers Razorpay covers UPI + cards + netbanking.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Webhook secret for POST /api/webhooks/razorpay. Without it that endpoint
# rejects every call (401). Add the endpoint in the Razorpay dashboard for
# payment.captured, order.paid and payment.authorized.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Access control / ownership
# ---------------------------------------------------------------------------
# Comma-separated tenant ids (firebase uids) that never need a plan AND may read
# another tenant's data for support. Every such read is logged OWNER_ACCESS.
# An entry containing "@" is read as an email instead of a uid.
OWNER_TENANT_IDS=""

# Owner sign-in addresses (comma separated). The server learns the uid on the
# first verified sign-in and remembers it in DATA_DIR/owner-uids.json.
OWNER_EMAILS=""

# Comma-separated tenant ids that keep working with no plan and never expire but
# get NO owner powers. Use for App Review test accounts and goodwill customers.
COMP_TENANT_IDS=""

# Firebase project whose ID tokens the API accepts. Leave empty to read it from
# firebase-applet-config.json; set it on the host so verification never depends
# on that file being uploaded.
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# ---------------------------------------------------------------------------
# Business identity (public pages + payment-provider review)
# ---------------------------------------------------------------------------
SUPPORT_EMAIL="support@your-domain.com"
# Legacy field. Keep it empty: nothing public prints a phone number any more.
# The public contact route is the complaint form below, and the number that
# receives complaints is COMPLAINT_WHATSAPP_TO — never shown to a visitor.
SUPPORT_PHONE=""
BUSINESS_NAME="Your Business Name"
BUSINESS_ADDRESS="Your registered business address"

# ---------------------------------------------------------------------------
# Complaint form -> owner WhatsApp (public /complaint page)
# ---------------------------------------------------------------------------
# Where a complaint is delivered. This is a server-side secret: it is never
# rendered into a page, so your number stays private while customers can still
# reach you. Leave both empty and the form keeps working — complaints are stored
# and listed in the Ops Console — but no WhatsApp push is attempted.
COMPLAINT_WHATSAPP_TO="+91 00000 00000"
# One-time activation: from the number above, send the WhatsApp message
# "I allow callmebot to send me messages" to +34 623 78 64 49 (the current
# CallMeBot bot number as of Oct 2026 — the old +34 623 75 84 18 bot was retired;
# see callmebot.com/move). The bot replies with the API key to put here.
CALLMEBOT_API_KEY=""
# Optional. Override only if you swap the relay for another provider.
CALLMEBOT_ENDPOINT=""

# ---------------------------------------------------------------------------
# Customer health monitoring — admin alerts (server/adminAlertNotifier.ts)
# ---------------------------------------------------------------------------
# Incidents always show in the owner Ops Console. External channels are
# optional and honestly reported as "setup required" until configured.
#
# Email: one JSON POST { from, to, subject, text } to ALERT_EMAIL_API_URL with
# a Bearer ALERT_EMAIL_API_KEY. The default URL works with Resend; any REST
# provider accepting that body shape works too. Small volume (<50/day).
# All four variables are required for email to turn on — nothing is sent
# while any is missing, and /healthz + the console show setup-required.
ALERT_EMAIL_API_KEY=""
ALERT_EMAIL_FROM="alerts@your-domain.com"
ALERT_EMAIL_TO="owner@your-domain.com"
ALERT_EMAIL_API_URL=""

# WhatsApp push (reuses the complaint relay). Enabled when the two relay vars
# above at the bottom of this file are set; set "true" here to silence it.
ALERT_WHATSAPP_DISABLE="false"

# Noise tuning (all optional, sane defaults in code):
# ALERT_SEND_FAIL_THRESHOLD   confirmed reply failures per customer per window (default 3)
# ALERT_AI_FAIL_THRESHOLD     AI provider failures per customer per window (default 3)
# ALERT_WINDOW_MINUTES        that window's length (default 30)
# ALERT_COOLDOWN_MINUTES      min minutes between repeat alerts for one incident (default 60)
# ALERT_SILENCE_MAX_HOURS     max hours since last inbound for the no-reply check (default 6)
